#include <iostream>

using namespace std;

int main() {
    int numero, suma = 0;
    
    cout << "Ingrese un numero: ";
    cin >> numero;
    
    if (numero < 0) {
        numero = -numero; 
    }
    
    while (numero > 0) {
        suma += numero % 10; 
        numero /= 10;        
    }
    
    cout << "Resultado: " << suma << endl;
    
    return 0;
}
