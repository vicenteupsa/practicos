/*4.  Calcular el aguinaldo navideño de un trabajador boliviano, 
dados: nombre, salario mensual y meses trabajados en el año. 
El aguinaldo equivale a un salario mensual si trabajó los 12 meses; 
si trabajó menos, se calcula de forma proporcional: Aguinaldo = Salario × Meses / 12.
Nota: Aplica la normativa boliviana vigente de beneficios sociales. */

#include <iostream>
#include <string>

using namespace std;

int main(){
    
    string nombre;
    double salario, aguinaldo ;
    int mesestrabajados ;
    
    cout << "Calculadora de Aguinaldo" << endl;
    
    cout <<"Ingrese su nombre: " << endl;
    getline(cin,nombre);
    
    cout << "Ingrese meses trabajados: " << endl ;
    cin >> mesestrabajados ;
    
    cout << "Ingrese su salario: " << endl;
    cin >> salario ;
    
    aguinaldo = ((salario*mesestrabajados)/12);
    
    cout << nombre << " Su aguinaldo es: " << aguinaldo << endl;
    
    return 0;
    
    
}

